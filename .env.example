# Copy this file to .env and fill in values locally.
# Never commit .env or kaggle.json.

# Kaggle API (required for Kaggle datasets)
# Create a token at https://www.kaggle.com/settings → API → Create New Token
# Either set these two variables:
KAGGLE_USERNAME=
KAGGLE_KEY=

# Or place kaggle.json at ~/.kaggle/kaggle.json (standard Kaggle CLI location).

# Hugging Face (optional for the approved public datasets)
# UVH-26 and the helmet dataset are public; a token is not required to download them.
# Set this only if you hit rate limits or later add a gated dataset.
HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
